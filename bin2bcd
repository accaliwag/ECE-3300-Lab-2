module bin2bcd(
    input  [7:0] bin,
    output [11:0] bcd
);

    wire [3:0] s1;
    wire [3:0] s2;
    wire [3:0] s3;
    wire [3:0] s4;
    wire [3:0] s5;
    wire [3:0] s6;
    wire [3:0] s7;

    add_3 add1 (
        .A({1'b0, bin[7], bin[6], bin[5]}),
        .S(s1)
    );

    add_3 add2 (
        .A({s1[2], s1[1], s1[0], bin[4]}),
        .S(s2)
    );

    add_3 add3 (
        .A({s2[2], s2[1], s2[0], bin[3]}),
        .S(s3)
    );

    add_3 add4 (
        .A({1'b0, s1[3], s2[3], s3[3]}),
        .S(s4)
    );

    add_3 add5 (
        .A({s3[2], s3[1], s3[0], bin[2]}),
        .S(s5)
    );

    add_3 add6 (
        .A({s4[2], s4[1], s4[0], s5[3]}),
        .S(s6)
    );

    add_3 add7 (
        .A({s5[2], s5[1], s5[0], bin[1]}),
        .S(s7)
    );

    assign bcd[11] = 1'b0;
    assign bcd[10] = 1'b0;

    assign bcd[9] = s4[3];

    assign bcd[8] = s6[3];
    assign bcd[7] = s6[2];
    assign bcd[6] = s6[1];
    assign bcd[5] = s6[0];

    assign bcd[4] = s7[3];
    assign bcd[3] = s7[2];
    assign bcd[2] = s7[1];
    assign bcd[1] = s7[0];

    assign bcd[0] = bin[0];

endmodule
